rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() {
      return signedIn() && hasProfile() && myRole() == 'admin';
    }
    function isSheikh() { return signedIn() && (isAdmin() || (hasProfile() && myRole() == 'sheikh')); }
    function txt(f, max) {
      return request.resource.data[f] is string && request.resource.data[f].size() > 0 && request.resource.data[f].size() <= max;
    }
    function active() { return isAdmin() || (hasProfile() && myRole() != 'banned'); }
    function ownsNew() { return signedIn() && request.resource.data.uid == request.auth.uid && active(); }

    // الإشراف التلقائي: الكلمات الممنوعة (يحددها المدير) ومنع الروابط لغير المشايخ
    function modPath() { return /databases/$(database)/documents/settings/moderation; }
    function clean(f) {
      return !exists(modPath()) || !request.resource.data[f].lower().matches(get(modPath()).data.pattern);
    }
    function noLinks(f) {
      return isSheikh() || !request.resource.data[f].lower().matches('(?s).*(https?://|www[.]|t[.]me/|wa[.]me/).*');
    }
    // البلاغ: العضو يضيف معرّفه فقط إلى قائمة المبلّغين ولا يغيّر شيئاً آخر
    function reportOnly() {
      let old = resource.data.get('reporters', []);
      return signedIn() && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reporters'])
        && request.resource.data.reporters.size() == old.size() + 1
        && request.resource.data.reporters.hasAll(old)
        && request.resource.data.reporters.hasAny([request.auth.uid])
        && !old.hasAny([request.auth.uid]);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role && clean('name'));
      allow delete: if isAdmin();
    }

    // إعدادات الإشراف: الجميع يقرأ، المدير فقط يعدّل
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // المحتوى المخفي بالبلاغات: أي عضو يسجّله، والمدير فقط يراه ويحذفه
    match /flags/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // المقالات والصوتيات والفيديوهات والكتب: القراءة للجميع، الإضافة للمشايخ والمدير
    match /posts/{id}  { allow read: if true; allow create, update, delete: if isSheikh(); }
    match /audios/{id} { allow read: if true; allow create, update, delete: if isSheikh(); }
    match /videos/{id} { allow read: if true; allow create, update, delete: if isSheikh(); }
    match /books/{id}  { allow read: if true; allow create, update, delete: if isSheikh(); }

    // المنتدى: أي عضو مسجّل يكتب موضوعاً
    match /threads/{id} {
      allow read: if true;
      allow create: if ownsNew() && txt('title', 200) && txt('body', 10000)
        && clean('title') && clean('body') && noLinks('body');
      allow update: if isAdmin() || reportOnly()
        || (signedIn() && active() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid
            && clean('title') && clean('body') && noLinks('body'));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // الفتاوى: السؤال لا يظهر للعامة إلا بعد الإجابة
    match /questions/{id} {
      allow read: if resource.data.status == 'answered'
        || (signedIn() && (resource.data.uid == request.auth.uid || isSheikh()));
      allow create: if ownsNew() && request.resource.data.status == 'pending'
        && !('answer' in request.resource.data) && txt('body', 5000)
        && clean('body') && clean('title') && noLinks('body');
      allow update: if isSheikh();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // رسائل اتصل بنا: أي زائر يرسل، والمدير فقط يقرأ ويحذف
    match /messages/{id} {
      allow create: if txt('name', 80) && txt('email', 120) && txt('text', 3000) && txt('subject', 40);
      allow read, delete: if isAdmin();
    }

    // التعليقات والردود
    match /{coll}/{docId}/comments/{cid} {
      allow read: if coll in ['posts', 'audios', 'videos', 'books', 'threads', 'questions'];
      allow create: if coll in ['posts', 'audios', 'videos', 'books', 'threads', 'questions']
        && ownsNew() && txt('text', 3000) && clean('text') && noLinks('text')
        && (!('badge' in request.resource.data) || isSheikh());
      allow update: if isAdmin() || reportOnly();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
