rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() {
      return signedIn() && hasProfile() && myRole() == 'admin';
    }
    function isSheikh() { return signedIn() && (isAdmin() || (hasProfile() && myRole() == 'sheikh')); }
    function txt(f, max) {
      return request.resource.data[f] is string && request.resource.data[f].size() > 0 && request.resource.data[f].size() <= max;
    }
    // العضو النشط: غير محظور وبريده مؤكَّد (حسابات جوجل مؤكدة تلقائياً)
    function active() { return isAdmin() || (hasProfile() && myRole() != 'banned' && request.auth.token.email_verified == true); }
    // البريد المؤقت ممنوع
    function tempEmail() {
      return request.auth.token.email != null
        && request.auth.token.email.lower().split('@')[1] in ['mailinator.com', 'mailinator.net', 'guerrillamail.com', 'guerrillamail.net', 'guerrillamailblock.com', 'grr.la', 'sharklasers.com', '10minutemail.com', '10minutemail.net', 'temp-mail.org', 'temp-mail.io', 'tempmail.com', 'tempmailo.com', 'tempmail.net', 'tempail.com', 'yopmail.com', 'yopmail.fr', 'yopmail.net', 'getnada.com', 'nada.email', 'trashmail.com', 'dispostable.com', 'maildrop.cc', 'mohmal.com', 'emailondeck.com', 'fakeinbox.com', 'throwawaymail.com', 'mintemail.com', 'mytemp.email', 'burnermail.io', 'spamgourmet.com', 'mailnesia.com', 'mailcatch.com', 'inboxkitten.com', 'moakt.com', 'tmail.ws', 'emailfake.com', 'tempr.email', 'discard.email', 'mail.tm', '1secmail.com', '1secmail.net', '1secmail.org', 'tempinbox.com', 'minuteinbox.com', 'mail-temp.com', 'mailpoof.com', 'luxusmail.org', 'fakemail.net', 'tempmailaddress.com', 'emailtemporanea.com', '33mail.com', 'spambox.us', 'trbvm.com', 'dropmail.me'];
    }
    // الاسم محجوز لهذا المستخدم في usernames
    function nameOk() {
      return request.resource.data.nameKey is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.nameKey)).data.uid == request.auth.uid;
    }
    function ownsNew() { return signedIn() && request.resource.data.uid == request.auth.uid && active(); }

    // الإشراف التلقائي: الكلمات الممنوعة (يحددها المدير) ومنع الروابط لغير المشايخ
    function modPath() { return /databases/$(database)/documents/settings/moderation; }
    function clean(f) {
      return !exists(modPath()) || !request.resource.data[f].lower().matches(get(modPath()).data.pattern);
    }
    function noLinks(f) {
      return isSheikh() || !request.resource.data[f].lower().matches('(?s).*(https?://|www[.]|t[.]me/|wa[.]me/).*');
    }
    // البلاغ: العضو يضيف معرّفه فقط إلى قائمة المبلّغين ولا يغيّر شيئاً آخر
    function reportOnly() {
      let old = resource.data.get('reporters', []);
      return signedIn() && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reporters'])
        && request.resource.data.reporters.size() == old.size() + 1
        && request.resource.data.reporters.hasAll(old)
        && request.resource.data.reporters.hasAny([request.auth.uid])
        && !old.hasAny([request.auth.uid]);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user' && !tempEmail() && nameOk();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role && clean('name')
            && (request.resource.data.get('nameKey', '') == resource.data.get('nameKey', '') || nameOk()));
      allow delete: if isAdmin();
    }

    // الأسماء المحجوزة: كل اسم لصاحب واحد فقط (لا يمكن الكتابة فوق اسم موجود)
    match /usernames/{key} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && key.size() <= 60 && !tempEmail();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // الإحصائيات اليومية: الزوار يزيدون العدادات فقط، والمدير وحده يقرأ
    match /stats/{day} {
      allow read: if isAdmin();
      allow create, update: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['views', 'visitors', 'pages', 'countries', 'devices', 'comments', 'questions', 'threads', 'content', 'signups']);
    }

    // إعدادات الإشراف: الجميع يقرأ، المدير فقط يعدّل
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // المحتوى المخفي بالبلاغات: أي عضو يسجّله، والمدير فقط يراه ويحذفه
    match /flags/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // المقالات والصوتيات والفيديوهات والكتب: القراءة للجميع، الإضافة للمشايخ والمدير
    match /posts/{id}  { allow read: if true; allow create, update, delete: if isSheikh(); }
    // عدّاد زيادة بواحد فقط (الاستماع / المشاهدات) لأي زائر
    function bumpOnly(f) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([f])
        && request.resource.data[f] == resource.data.get(f, 0) + 1;
    }
    match /audios/{id} { allow read: if true; allow create, delete: if isSheikh(); allow update: if isSheikh() || bumpOnly('plays'); }
    match /videos/{id} { allow read: if true; allow create, update, delete: if isSheikh(); }
    // الكتب: أي عضو ينشر كتاباً بعد إكمال بيانات الناشر، ويبقى «بانتظار المراجعة» حتى يعتمده شيخ أو المدير
    function bookOk() {
      let d = request.resource.data;
      return txt('title', 200) && txt('author', 150) && txt('url', 1500)
        && d.desc is string && d.desc.size() >= 50 && d.desc.size() <= 5000
        && clean('title') && clean('desc') && clean('author') && noLinks('desc');
    }
    match /books/{id} {
      allow read: if resource == null || resource.data.get('status', 'published') == 'published' || isSheikh()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSheikh()
        || (ownsNew() && request.resource.data.status == 'pending' && bookOk()
            && exists(/databases/$(database)/documents/publishers/$(request.auth.uid)));
      allow update: if isSheikh()
        || (signedIn() && active() && resource.data.uid == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.status == 'pending' && request.resource.data.uid == resource.data.uid && bookOk());
      allow delete: if isSheikh() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // بيانات الناشر العامة (الاسم والبلد والنبذة فقط) — رقم الجوال ومكان الإقامة وتاريخ الميلاد تبقى في users (خاصة)
    match /publishers/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid && active()
        && request.resource.data.keys().hasOnly(['name', 'country', 'bio', 'updatedAt'])
        && txt('name', 60) && txt('country', 4) && txt('bio', 600) && request.resource.data.bio.size() >= 20
        && clean('bio') && noLinks('bio');
      allow delete: if isAdmin();
    }

    // المنتدى: أي عضو مسجّل يكتب موضوعاً
    match /threads/{id} {
      allow read: if true;
      allow create: if ownsNew() && txt('title', 200) && txt('body', 10000)
        && clean('title') && clean('body') && noLinks('body');
      allow update: if isAdmin() || reportOnly()
        || (signedIn() && active() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid
            && clean('title') && clean('body') && noLinks('body'));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // الفتاوى: السؤال لا يظهر للعامة إلا بعد الإجابة
    match /questions/{id} {
      allow read: if resource.data.status == 'answered'
        || (signedIn() && (resource.data.uid == request.auth.uid || isSheikh()));
      allow create: if ownsNew() && request.resource.data.status == 'pending'
        && !('answer' in request.resource.data) && txt('body', 5000)
        && clean('body') && clean('title') && noLinks('body');
      allow update: if isSheikh() || (resource.data.status == 'answered' && bumpOnly('views'));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // رسائل اتصل بنا: أي زائر يرسل، والمدير فقط يقرأ ويحذف
    match /messages/{id} {
      allow create: if txt('name', 80) && txt('email', 120) && txt('text', 3000) && txt('subject', 40);
      allow read, delete: if isAdmin();
    }

    // التعليقات والردود
    match /{coll}/{docId}/comments/{cid} {
      allow read: if coll in ['posts', 'audios', 'videos', 'books', 'threads', 'questions'];
      allow create: if coll in ['posts', 'audios', 'videos', 'books', 'threads', 'questions']
        && ownsNew() && txt('text', 3000) && clean('text') && noLinks('text')
        && (!('badge' in request.resource.data) || isSheikh());
      allow update: if isAdmin() || reportOnly();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
